{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    "includes": [
      "!public",
      "!components/ui",
      "!hooks/use-mobile.ts",
      "!lib/utils.ts",
      "!.source",
      "!app/retro-globals.css"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noLeakedRender": "off"
      }
    }
  }
}
